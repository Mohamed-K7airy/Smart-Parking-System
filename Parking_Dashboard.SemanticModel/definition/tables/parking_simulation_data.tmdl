table parking_simulation_data
	lineageTag: 6e761df1-4493-4706-9d51-5a71a79eb5fe

	measure Peak_Hour_Formatted =
			
			VAR MaxHour = MAX(parking_simulation_data[Peak_Hour_KPI])
			VAR Hour12 = IF(MaxHour = 0 || MaxHour = 24, 12, IF(MaxHour > 12, MaxHour - 12, MaxHour))
			VAR Period = IF(MaxHour >= 12, "PM", "AM")
			RETURN
			Hour12 & " " & Period
		lineageTag: 16d101f4-a1b1-442e-bab9-75d7965855ca

	measure Smart_Alert_Formatted = ```
			
			VAR AlertVal = SELECTEDVALUE(parking_simulation_data[Smart_Alert])
			RETURN
			IF(
			    ISBLANK(AlertVal), 
			    "🟢 Smooth Flow" & UNICHAR(10) & "- Spots Available", 
			    AlertVal
			)
			```
		lineageTag: 59b0318a-fe0c-4ad0-abb6-3d98bda0939f

