	partition parking_simulation_data = m
		mode: import
		source = ```
				let
				    // 1. تعريف مسار الفولدر كمتغير (تعدله من مكان واحد لو حبيت)
				    Folder_Path =  "D:\مذاكرة\computer vison NTI\project\Smart-Parking-System\",
				    
				    // 2. دمج المسار مع اسم الملف
				    Full_Path = Folder_Path & "parking_simulation_data.csv",
				    
				    // 3. سحب الملف
				    Source = Csv.Document(File.Contents(Full_Path),[Delimiter=",", Columns=18, Encoding=1256, QuoteStyle=QuoteStyle.None]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"Date", type date}, {"Hour", Int64.Type}, {"Timestamp", type datetime}, {"Time", type text}, {"Slot_ID", type text}, {"Slot_Type", type text}, {"Zone", type text}, {"Status", type text}, {"Status_Code", Int64.Type}, {"System_Status", type text}, {"PARKING OCCUPANCY", type number}, {"Total_Cars_Today", Int64.Type}, {"Total_Revenue", type number}, {"Avg_Parking_Duration_Hour", type number}, {"Peak_Hour_KPI", Int64.Type}, {"Potential_Lost_Revenue", type number}, {"Slot_Turnover_Rate", type number}, {"Smart_Alert", type text}})
				in
				    #"Changed Type"
				```

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

