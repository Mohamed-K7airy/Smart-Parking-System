	column Slot_Type = ```
			
			VAR SlotDailyHours = 
			    CALCULATE(
			        SUM(parking_simulation_data[PARKING OCCUPANCY]),
			        ALLEXCEPT(parking_simulation_data, parking_simulation_data[Slot_ID], parking_simulation_data[Date])
			    )
			RETURN
			IF(SlotDailyHours <= 8, "قصيرة (Short-stay)",
			    IF(SlotDailyHours <= 16, "متوسطة (Medium-stay)", "طويلة (Long-stay)")
			)
			```
		lineageTag: 54cd92c5-7493-4567-a921-4c0e37f0fe50
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

